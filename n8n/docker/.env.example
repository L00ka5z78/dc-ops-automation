# Skopiuj do .env, ustaw wartości, a następnie: chmod 600 .env
# Plik .env jest w .gitignore — nigdy go nie commituj.

# Wersja obrazu n8n (WYMAGANE, bez 'latest').
# Sprawdź aktualną stabilną wersję w release notes n8n i GitHub Security Advisories
# przed wdrożeniem. n8n wydaje łatki bezpieczeństwa regularnie.
N8N_VERSION=

# Klucz szyfrujący credentials w n8n (WYMAGANE).
# Wygeneruj: openssl rand -hex 32
# Zachowaj kopię poza serwerem (menedżer haseł) — bez niego credentials są nie do odczytania.
N8N_ENCRYPTION_KEY=

# Adres, pod którym wywołania webhooków i linki zatwierdzające są widoczne dla przeglądarki.
# Przy dostępie przez tunel SSH (-L 5678:127.0.0.1:5678):
N8N_WEBHOOK_URL=http://localhost:5678/
